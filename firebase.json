{
  "hosting": {
    "site": "asternal",
    "public": "dist/public",
    "predeploy": ["bun run build"],
    "ignore": ["firebase.json", "**/.*", "**/*.map", "node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
