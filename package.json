{
  "name": "asternal-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc -b && vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --loader:.md=text --outdir=dist",
    "build:dev": "vite build --mode development",
    "start": "NODE_ENV=production node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy:hosting": "firebase deploy --only hosting:asternal",
    "deploy:rules": "firebase deploy --only storage:rules"
  },
